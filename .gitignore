# Media included in documentation and the ESP32 build must be specifically
# authorized. Whitelist the build-time WAV files (not the whole media tree).
/docs/assets/*
!/docs/assets/deepseek-live-icon.png
/firmware/esp32/**/main/assets/*
# Firmware prompts (VOICE.WAV, R185_GREETING.WAV) are required locally but
# not yet covered by the specific R503 video-voice source attestation.
# Keep them ignored until their own provenance is separately approved.

# Explicit release-assets path: only selected, rights-cleared voice fixtures
# may be made public. Research/private audio stays ignored.
/release-assets/voice/*
!/release-assets/voice/README.md
# R503 reference WAV: original video is licensed (owner attestation);
# select ONLY this approved final sample for source control.
!/release-assets/voice/r503-reference.wav
!/release-assets/voice/r503-reference.txt
# Non-build artifacts from prior LVGL font previews and agent design runs.
# Current r487 font sources remain tracked and available for real builds.
/docs/superpowers/
/firmware/esp32/unified-wifi-wake/main/lv_font_r486_cn_*.c

